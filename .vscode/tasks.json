{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "cppbuild",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/std:c++17",
                "/Iinclude",
                "/Isrc",
                "src\\*.cpp",
                "src\\glad.c",
                "/Fobuild\\",
                "/Fesrc\\kaczka.exe",
                "/Fdsrc\\kaczka.pdb",
                "/MDd",
                "/link",
                "/NODEFAULTLIB:MSVCRT",
                "/LIBPATH:lib",
                "glfw3.lib",
                "opengl32.lib",
                "kernel32.lib",
                "user32.lib",
                "gdi32.lib",
                "shell32.lib"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ]
        }
    ]
}